{
  "name": "@vertana/context-web",
  "version": "0.1.2",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./fetch": "./src/fetch.ts",
    "./extract-links": "./src/extract-links.ts"
  },
  "exclude": [
    "dist/",
    "tsdown.config.ts"
  ],
  "tasks": {
    "build": "pnpm build",
    "test": "deno test --allow-env --allow-net --parallel",
    "test:node": {
      "dependencies": [
        "build"
      ],
      "command": "node --experimental-transform-types --test --test-concurrency=4"
    },
    "test:bun": {
      "dependencies": [
        "build"
      ],
      "command": "bun test"
    },
    "test-all": {
      "dependencies": [
        "test",
        "test:node",
        "test:bun"
      ]
    }
  }
}
